/-- Concrete Migdal–Kadanoff block-spin step (block size L = 2).
    r → r²  (character ratio squares under one decimation step).
    Since 0 < r < 1, r² < r → ratio strictly decreases → gap grows. -/
noncomputable def HierarchicalMKStep (s : HierarchicalState) : HierarchicalState :=
  ⟨s.ratio ^ 2, pow_pos s.h_pos 2, by nlinarith [s.h_pos, s.h_lt_one]⟩

/-- Iterated MK flow: n block-spin decimations from initial state s₀. -/
noncomputable def HierarchicalIteratedRG : ℕ → HierarchicalState → HierarchicalState
